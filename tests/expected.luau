Expected.scenes = sceneList

--- Expected.linesOf(name): the text the reference prints while rendering `name`
function Expected.linesOf(name: string): { string }
	for i = 1, #sceneList do
		local s = sceneList[i]
		if s.name == name then
			return s.lines
		end
	end
	return {}
end

return Expected
